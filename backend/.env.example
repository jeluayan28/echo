# ECHO backend — example environment.
# Copy to `.env` and fill in real values. `.env` is git-ignored: NEVER commit real credentials.
# Every value below is a placeholder.

APP_NAME=ECHO
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL 15+ required: composite foreign keys use ON DELETE SET NULL (column)) ──
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=echo
DB_USERNAME=echo_app
# The password of YOUR PostgreSQL role. Use a dedicated, least-privilege role in production.
DB_PASSWORD=change-me
# Production: DB_SSLMODE=require

# The test suite uses the database "echo_test" on the same server (forced in phpunit.xml) and WIPES it.
# It must exist before running tests:  createdb echo_test

# ── Auth (Sanctum bearer tokens) ──
# Token lifetime in minutes (default 43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# ── CORS ──
# Browser origins allowed to call the API, comma-separated, NO wildcard. The native app does not need CORS;
# this is for the Expo web build / a future web client. Leave unset locally (defaults to the Expo dev ports);
# in production list your real origin(s) or leave it empty to allow none.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Behind a load balancer / reverse proxy, list its IPs (or "*" only if the proxy is trusted) so rate limiting
# and URL generation see the real client.
# TRUSTED_PROXIES=

# ── Files (voice recordings) ──
# A PRIVATE disk from config/filesystems.php. "local" = storage/app/private. In production use an
# S3-compatible disk ("s3") and fill the AWS_* values below.
ECHO_ATTACHMENT_DISK=local
ECHO_ATTACHMENT_MAX_KB=25600
ECHO_ORPHAN_TTL_HOURS=24
ECHO_TRASH_RETENTION_DAYS=30
FILESYSTEM_DISK=local

# ── Demo data (php artisan db:seed — development only) ──
# Choose a password for the demo account, or leave empty to have one generated and printed once.
# DEMO_USER_EMAIL=demo@echo.test
# DEMO_USER_PASSWORD=

# ── Queue / cache / sessions (the API itself is stateless; these back rate limiting and jobs) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Optional semantic search ("search by meaning") — OFF by default ──
# Needs PostgreSQL with the pgvector extension AND an OpenAI-compatible embeddings endpoint. When on, the text of
# opted-in users' memories (title, body, tags) and their meaning-based queries are sent to that endpoint, so say
# truthfully where it runs. Users must also opt in themselves in the app. Install pgvector BEFORE migrating.
# ECHO_SEMANTIC_ENABLED=false
# ECHO_SEMANTIC_PROCESSING=self-hosted   # or: external   (required; no default)
# ECHO_SEMANTIC_PROVIDER_LABEL="your Ollama server"
# ECHO_SEMANTIC_BASE_URL=http://127.0.0.1:11434/v1   # external endpoints must be https
# ECHO_SEMANTIC_API_KEY=
# ECHO_SEMANTIC_MODEL=nomic-embed-text
# ECHO_SEMANTIC_DIMENSIONS=384          # = the model's output size = the vector(N) column; set BEFORE migrating
# ECHO_SEMANTIC_MAX_DISTANCE=0.6        # cosine distance cut-off; tune for your model
# Embeddings are computed by queued jobs: run a worker (php artisan queue:work) — QUEUE_CONNECTION=sync computes inline.

# ── S3-compatible object storage (only if ECHO_ATTACHMENT_DISK=s3) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
