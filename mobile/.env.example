# Public values only - anything EXPO_PUBLIC_* is bundled into the app, so NEVER put a secret here.
#
# Which environment this build talks to: development | staging | production
# (default: development in dev builds, production in release builds)
EXPO_PUBLIC_APP_ENV=development

# DEVELOPMENT. Leave unset and the app finds your computer by itself (it uses the address Metro runs on),
# which works on a physical phone, the Android emulator and the iOS simulator.
# Set it only to point at a different machine. "localhost" on a phone is the phone itself; the app rewrites
# localhost / 127.0.0.1 to your computer's address (10.0.2.2 on the Android emulator) so a copied value still works.
# The Laravel server must listen on all interfaces:  php artisan serve --host=0.0.0.0 --port=8000
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api

# STAGING / PRODUCTION: required when EXPO_PUBLIC_APP_ENV is set to that environment, and must be https://
# (set them per build profile in eas.json, or as EAS environment variables)
# EXPO_PUBLIC_API_URL_STAGING=https://api.staging.example.com/api
# EXPO_PUBLIC_API_URL_PRODUCTION=https://api.example.com/api
